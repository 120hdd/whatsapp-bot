# Production examples: /var/lib/sajadbot-whatsapp/app.db and /var/lib/sajadbot-whatsapp
DATABASE_PATH=./data/app.db
STATE_DIR=./data
MEDIA_DIR=./data/media
LOCK_PATH=./data/daemon.lock
LOG_LEVEL=info
TIMEZONE=UTC

DRY_RUN=false
WORKER_POLL_MS=1000
SEND_INTERVAL_MS=8000
MAX_ATTEMPTS=5
RETRY_BASE_MS=5000
RETRY_MAX_MS=300000
MAX_MEDIA_BYTES=2147483648

SELF_CONTROLLER_ENABLED=false
PAIRING_PHONE=
